# Copy this file to .env and fill in every value. Never commit .env.
# All of these are required for the app to start.

# Random long string used to sign login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Public base URL of the app (no trailing slash). Used for Stripe redirects.
# Local dev: http://localhost:3000
# Railway: https://your-app-name.up.railway.app
APP_URL=http://localhost:3000

# Stripe (use TEST mode keys while developing: they start with sk_test_ / pk_test_)
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_PRICE_ID=price_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# OpenAI — OPTIONAL. App works without it; AI features show "not enabled" until set.
# (create at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-replace-me
# Optional: override the chat model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: max AI messages per user per day (default: 100)
# DAILY_MESSAGE_LIMIT=100

# Optional: database file location (default: ./data/app.db)
# DB_PATH=./data/app.db

# OPTIONAL: password for the /admin.html page (grant/revoke free Premium accounts).
# Pick any long random string. The admin tools refuse to work until this is set.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ADMIN_PASSWORD=replace-me-with-something-long-and-random

# Optional: set to "production" on your host
# NODE_ENV=production
